---
const PAGE_TITLE_ID = "_top";
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>

<style>
  h1 {
    margin-top: 1rem;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  @media (min-width: 50rem) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
</write_to_file>